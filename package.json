{
  "name": "possumtales",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "possumtales.com - a quote blog, 2005-2017, rebuilt as a static React SPA",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "extract": "node scripts/extract.mjs",
    "uploads": "node scripts/copy-uploads.mjs --clean",
    "lockfile": "node scripts/normalize-lockfile.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22"
  }
}
